# Copy this file to .env.production and replace every required blank value.
# Never commit .env.production.

POSTGRES_DB=factorymind
POSTGRES_USER=factorymind
POSTGRES_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=factorymind

JWT_KEY=
GEMINI_API_KEY=

# Only used when the production database has no Company or User yet.
BOOTSTRAP_COMPANY_NAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Public Nginx port and immutable GHCR release. deploy.sh validates this as a
# full 40-character Git commit SHA. Never use prod/latest/main for a deployment.
HTTP_PORT=80
IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
GITHUB_REPOSITORY_OWNER=johnvo402
APP_PULL_POLICY=always

# Host-local release state and sensitive backup storage. Prefer paths outside
# the repository on a real VPS. Directories are created with private permissions.
FACTORYMIND_STATE_DIR=/opt/factorymind/releases
BACKUP_ROOT=/opt/factorymind/backups
BACKUP_RETENTION_COUNT=7
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# Bounded health/smoke behavior.
DEPLOY_HEALTH_TIMEOUT_SECONDS=180
SMOKE_CONNECT_TIMEOUT_SECONDS=5
SMOKE_REQUEST_TIMEOUT_SECONDS=15
SMOKE_RETRY_COUNT=10

# Delivery deadline window in calendar days; API validates 1..30.
PLANNING_DUE_SOON_DAYS=3
PLANNING_DEFAULT_SCHEDULE_HORIZON_DAYS=14
PLANNING_MAXIMUM_SCHEDULE_HORIZON_DAYS=90
PLANNING_MAXIMUM_ORDERS_PER_PREVIEW=500
PLANNING_MAXIMUM_OPERATIONS_PER_PREVIEW=5000

# Optional OpenTelemetry Protocol export.
OTLP_ENABLED=false
OTLP_ENDPOINT=
