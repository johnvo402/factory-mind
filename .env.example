POSTGRES_DB=factorymind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Used by the .NET configuration system when running the API on the host.
ConnectionStrings__FactoryMind=Host=localhost;Port=5432;Database=factorymind;Username=postgres;Password=postgres

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
Minio__Endpoint=localhost:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin
Minio__Bucket=factorymind
Minio__UseSsl=false

# Configure these before calling the Chat streaming endpoint.
Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta/
GEMINI_API_KEY=
Gemini__ChatModel=gemini-3.5-flash-lite
Gemini__EmbeddingModel=gemini-embedding-2
